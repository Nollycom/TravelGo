rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get user role from token OR from users doc
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role in ["ADMIN", "SUPER_ADMIN"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["ADMIN", "SUPER_ADMIN"])
      );
    }
    function isProvider() {
      return request.auth != null && (
        request.auth.token.role in ["PROVIDER", "ADMIN", "SUPER_ADMIN"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["PROVIDER", "ADMIN", "SUPER_ADMIN"])
      );
    }

    // ---- Public marketplace ----
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isProvider();
      allow update, delete: if request.auth != null && (
        resource.data.providerId == request.auth.uid || isAdmin()
      );
    }
    match /providers/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /destinations/{id} { allow read: if true; allow write: if isAdmin(); }
    match /reels/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // ---- Users ---- (temps réel — Auth activé)
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // lecture publique du profil minimal pour login fallback désactivé
      allow get: if true;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- Provider Requests (inscription agence) ---- (temps réel)
    match /providerRequests/{reqId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---- Quote Requests (devis) ----
    match /quoteRequests/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isProvider() || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ---- Notifications ----
    match /notifications/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---- Settings ----
    match /settings/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Catch-all (deny by default except read) ----
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
